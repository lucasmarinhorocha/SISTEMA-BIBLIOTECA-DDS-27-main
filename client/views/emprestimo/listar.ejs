<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1>Lista de empréstimos</h1>

    <% if (listaEmprestimos.length === 0) { %>
        <p>Nenhum empréstimo encontrado.</p>
    <% } else { %>

        <table class="table mt-5 table-bordered border-danger">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Leitor</th>
                    <th>Livro</th>
                    <th>Data do empréstimo</th>
                    <th>Previsão de devolução</th>
                    <th>Data de devolução</th>
                </tr>
            </thead>

            <tbody>
                <% listaEmprestimos.forEach(emprestimo => { %>
                    <tr>
                        <td>
                            <%= emprestimo.id_emprestimo %>
                        </td>

                        <td>
                            <%= emprestimo.nome_leitor %>
                        </td>

                        <td>
                            <%= emprestimo.titulo_livro %>
                        </td>

                        <td>
                            <%= emprestimo.dt_emprestimo %>
                        </td>

                        <td>
                            <%= emprestimo.dt_previsao_devolucao %>
                        </td>

                        <td>
                            <%= emprestimo.dt_devolucao || "Não devolvido" %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>

        </table>

    <% } %>

</main>

<%- include('../partials/footer') %>