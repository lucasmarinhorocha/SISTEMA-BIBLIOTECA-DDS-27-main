<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1>Lista de livros</h1>

    <a href="/livros/CriarLivro">
        <button class="btn-solid theme-accent">
            Novo livro
        </button>
    </a>

    <table class="table mt-5 table-bordered border-danger">

        <thead>
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>Ano de publicação</th>
                <th>Gênero</th>
                <th>Disponibilidade</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            <% listaLivro.forEach(livro => { %>

                <tr>
                    <td><%= livro.titulo %></td>
                    <td><%= livro.autor %></td>
                    <td><%= livro.ano_publicacao %></td>
                    <td><%= livro.genero %></td>

                    <td>
                        <% if (livro.esta_disponivel == 1) { %>
                            Disponível
                        <% } else { %>
                            Indisponível
                        <% } %>
                    </td>

                    <td>
                        <a
                            href="/livros/EditarLivro/<%= livro.id_livro %>"
                            class="btn-solid theme-warning"
                        >
                            Editar
                        </a>

                        <form action="/livros/deletar/<%= livro.id_livro %>" method="post"
                            onsubmit="return confirm('deseja realmente excluir esse usuário?')">
                       
                            <button type="submit" class="btn-solid theme-danger">
                                    Excluir
                            </button>
                        </form>
                    </td>
                </tr>

            <% }) %>
        </tbody>

    </table>

</main>

<%- include('../partials/footer') %>